@model IEnumerable<ICSLicenseMaintV2.License>

<table class="table table-condensed table-hover @(ViewBag.LicenseData == null ? "data" : "")">
    <thead>
        <tr>
            <th></th>
            <th class="hidden-xs" title="License ID which can be found in either the weblicense or RFSV3 license files (depending on the version) in the RTTC\License directory" >ID</th>
            <th class="hidden-xs" title="A hash of various machine values.
If this changes for the same server it means a customer has made a change to one of the values on their server and you will need to setup a new license.">Machine ID</th>
            <th title="The server name of the licensed machine">Machine Name</th>
            <th class="hidden-xs" title="The number of RF-SMART users.
This should match the sum of all of the &quot;RF-SMART for <ERP> User&quot; records on the customer record in NetSuite.">Users</th>
            <th class="hidden-xs" title="If check this license does not expire. If not checked this license will expire on the &quot;Expires&quot; date">Permanent</th>
            <th class="hidden-xs" title="The date that the license record will expire (Expired records will be highlighted in red)">Expires</th>
            <th class="hidden-xs" title="The date/time of the most recent change to the licensing record made by someone at ICS">Last Changed</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsExpired ? "danger" : "")">
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.LicenseID, controller="Licenses" }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.LicenseID, controller = "Licenses" })
                </td>
                <td class="hidden-xs">
                    @Html.DisplayFor(modelItem => item.LicenseID)
                </td>
                <td title="@item.MachineID" class="hidden-xs">
                    @Html.DisplayFor(modelItem => item.ShortMachineID)
                    <span style="display:none">@item.MachineID</span>
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MachineName)
                </td>
                <td class="hidden-xs">
                    @Html.DisplayFor(modelItem => item.TotalUserCount)
                </td>
                <td class="hidden-xs">
                    @Html.DisplayFor(modelItem => item.IsPermanent)
                </td>
                <td class="hidden-xs">@(item.IsPermanent ? "-" : item.ExpiryDate.ToShortDateString())</td>
                <td class="hidden-xs">@item.ChangeTime.ToShortDateString()</td>
            </tr>
        }
    </tbody>
</table>
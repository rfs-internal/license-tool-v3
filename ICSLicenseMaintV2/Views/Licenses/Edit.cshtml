@model ICSLicenseMaintV2.License

@{
    ViewBag.Title = string.Format("{0} License: {1}", ViewBag.CustomerName, Model.LicenseID);
}

@section Scripts{
    <script>
        function HeaderViewModel() {
            var self = this;
            self.customer = ko.observable();
            self.customers = [];
        }

        function DetailViewModel() {
            var self = this;
            self.modules = [];
            self.licensedModules = ko.observableArray();

            self.filter = ko.observable('');

            self.removeModule = function(module){
                self.licensedModules.remove(module);
            };

            self.removeAll = function () {
                self.licensedModules([]);
            };

            self.toggleVisible = function () {
                var visibleModules = self.modules.filter(function (m) { return m.isvisible() });
                if (visibleModules.length > 0) {
                    var state = visibleModules[0].selected();
                    visibleModules.forEach(function (m) { m.selected(!state); });
                }
            };

            self.applyChanges = function () {
                var lookup = {};
                var temp = self.licensedModules();
                temp.forEach(function (t) { lookup[t.id] = true; });
                var selections = self.modules.filter(function (m) { return m.selected() });
                selections.forEach(function (m) {
                    if (!lookup[m.id]) {
                        temp.push(m);
                    }
                });
                temp = temp.sort(function (l, r) { return l.name < r.name ? -1 : 1; });
                self.licensedModules(temp);
                self.modules.forEach(function (m) { m.selected(false); });
            }
        }

        $(document).ready(function () {
            $.get('/Customers/All', undefined, function(customers){
                var viewModel = new HeaderViewModel();
                viewModel.customers = customers;
                viewModel.customer('@Html.Raw(Model.CustomerID)');
                ko.applyBindings(viewModel, document.getElementById('licenseHeader'));
            });

            $.get('/Licenses/Modules', { id: '@Html.Raw(Model.LicenseID)' }, function(data){
                var viewModel = new DetailViewModel();
                viewModel.modules = data.modules;
                viewModel.modules.forEach(function (module) {
                    module.selected = ko.observable(false);
                    module.isvisible = ko.computed(function () {
                        var text = viewModel.filter().toLowerCase();
                        if (text) {
                            return module.name.toLowerCase().indexOf(text) > -1;
                        }
                        return true;
                    }).extend({ rateLimit: 500 });
                });
                viewModel.licensedModules(data.licensedModules);
                ko.applyBindings(viewModel, document.getElementById('licenseDetail'));
            });

        });
    </script>

    @Scripts.Render("~/bundles/jqueryval")
}

<h2>License</h2>
<h3>
    <a href="@Url.Action("Index", "Licenses", new { id = Model.CustomerID })">@Model.CustomerSite.Customer.CustomerName</a>
</h3>

<a href="@Url.Action("CopyExisting", new { id = Model.LicenseID })" class="btn btn-default pull-right">Copy Existing License</a>

<ul class="nav nav-tabs">
    <li role="presentation" class="active">
        <a href="#license" aria-controls="license" data-toggle="tab">License</a>
    </li>
    <li role="presentation">
        <a href="#modules" aria-controls="modules" data-toggle="tab">Modules</a>
    </li>
</ul>

<div class="tab-content">
    <div role="tabpanel" class="tab-pane fade in active" id="license">
        @Html.Partial("_LicenseHeader")
    </div>
    <div role="tabpanel" class="tab-pane fade" id="modules">
        @Html.Partial("_LicenseDetail")
    </div>
</div>


@Html.Partial("_NewCustomerAndSiteModal")

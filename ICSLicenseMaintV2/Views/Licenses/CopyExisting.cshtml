@model ICSLicenseMaintV2.License

@{
    ViewBag.Title = "Copy Existing License";
    var Modules = (IEnumerable<string>)ViewBag.Modules;
}

<h2>Copy Existing</h2>

<div class="alert alert-warning" role="alert">
    <ul>
        <li>This will copy the Customer, User Count, Expiration Date, and Modules from the entered <i>Source License</i> to the <i>Target License</i>. </li>
        <li>Existing modules on the <i>Target License</i> will be removed.</li>
        <li>If another license is found that matches <em>"@Model.MachineName"</em>, it's license id will default below (using the most recently changed license).</li>
    </ul>
</div>

<style>
    .source_text {
        text-align:right;
    }
</style>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="targetLicense" value="@Model.LicenseID" />
    <div class="form-horizontal">
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10  col-xs-12">
                <div class="pull-right">
                    <a href="javascript:history.back()" class="btn btn-default">Cancel</a>
                    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-share-alt" aria-hidden="true"></span> Copy</button>
                </div>
            </div>
        </div>
        <table class="table table-hover table-condensed">
            <tbody>
                <tr>
                    <td></td>
                    <td><h3 class="source_text">Source</h3></td>
                    <td></td>
                    <td><h3>Target</h3></td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.LicenseID:</label></td>
                    <td>
                        <input type="number" class="form-control source_text" name="sourceLicense" data-bind="value: searchText, valueUpdate: ['input', 'afterkeydown']" autofocus />
                        <span class="field-validation-valid text-danger" data-valmsg-for="sourceLicense" data-valmsg-replace="true"></span>
                    </td>
                    <td></td>
                    <td>@Model.LicenseID</td>
                </tr>
                <tr>
                    <td><label class="control-label">Site Name:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: SiteName" class="source_text" ></p>
                        </div>
                    </td>
                    <td><span class="glyphicon glyphicon-arrow-right"></span></td>
                    <td>@Model.CustomerSite.SiteName</td>
                </tr>
                <tr>
                    <td><label class="control-label">Customer Name:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: CustomerName" class="source_text" ></p>
                        </div>
                    </td>
                    <td><span class="glyphicon glyphicon-arrow-right"></span></td>
                    <td>@Model.CustomerSite.Customer.CustomerName</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.MachineID:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: MachineID" class="source_text" ></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.MachineID</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.InstallPath:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: InstallPath" class="source_text"></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.InstallPath</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.MachineName:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: MachineName" class="source_text" ></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.MachineName</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.UserCount:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: TotalUserCount" class="source_text" ></p>
                        </div>
                    </td>
                    <td><span class="glyphicon glyphicon-arrow-right"></span></td>
                    <td>@Model.TotalUserCount</td>
                </tr>
                <tr>
                    <td><label class="control-label">Is Permanent:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: IsPermanent" class="source_text" ></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.IsPermanent</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.DateIssued:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: DateIssued" class="source_text" ></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.DateIssued</td>
                </tr>
                <tr>
                    <td><label class="control-label">Expiration Date:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: ExpiryDate" class="source_text" ></p>
                        </div>
                    </td>
                    <td><span class="glyphicon glyphicon-arrow-right"></span></td>
                    <td>@Model.ExpiryDate</td>
                </tr>
                <tr>
                    <td><label class="control-label">@LicenseMaintStrings.ChangeTime:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p data-bind="text: ChangeTime" class="source_text" ></p>
                        </div>
                    </td>
                    <td></td>
                    <td>@Model.ChangeTime</td>
                </tr>
                <tr>
                    <td><label class="control-label">Modules:</label></td>
                    <td>
                        <div data-bind="with: license">
                            <p class="source_text" data-bind="foreach: Modules">
                                <span data-bind="text: $data"></span><br/>
                            </p>
                        </div>
                    </td>
                    <td><span class="glyphicon glyphicon-arrow-right"></span></td>
                    <td>@Html.Raw(string.Join("<br/>", Modules))</td>
                </tr>
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
    function LicenseViewModel() {
        var self = this;
        self.searchText = ko.observable('@ViewBag.SourceLicenseId');
        self.loading = ko.observable(false);
        self.license = ko.observable();

        $(document)
            .ajaxStart(function () { self.loading(true); })
            .ajaxStop(function () { self.loading(false); });

        self.delayedValue = ko.pureComputed(this.searchText)
            .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 400 } });

        self.delayedValue.subscribe(updateLicense, self);

        updateLicense(self.searchText());

        function updateLicense(val) {
            if (self.request) {
                self.request.abort();
            }
            self.license(undefined);
            self.request = $.post('/Licenses/Lookup', { id: val }, function (data) {
                self.license(data);
                self.request = undefined;
            });
        }
    }

    $(document).ready(function () {
        ko.applyBindings(new LicenseViewModel());
    });
</script>
}


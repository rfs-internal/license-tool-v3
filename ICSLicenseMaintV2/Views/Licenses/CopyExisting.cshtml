@model ICSLicenseMaintV2.License

@{
    ViewBag.Title = "Copy Existing License";
}

<h2>Copy Existing</h2>

<div class="alert alert-warning" role="alert">
    <ul>
        <li>This will copy the Customer, User Count, Expiration Date, and Modules from the entered <i>Source License</i> to the <i>Target License</i>. </li>
        <li>Existing modules on the <i>Target License</i> will be removed.</li>
        <li>If another license is found that matches <em>"@Model.MachineName"</em>, it's license id will default below (using the most recently changed license).</li>
    </ul>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div class="form-group">
            <label class="control-label col-md-2 col-xs-12">Target License:</label>
            <div class="col-md-4 col-xs-9">
                @Model.LicenseID
                <input type="hidden" name="targetLicense" value="@Model.LicenseID"/>
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-2 col-xs-12" for="sourceLicense">Source License:</label>
            <div class="col-md-4 col-xs-9">
                <input type="number" class="form-control" name="sourceLicense" data-bind="value: searchText, valueUpdate: ['input', 'afterkeydown']" />
                <span class="field-validation-valid text-danger" data-valmsg-for="sourceLicense" data-valmsg-replace="true"></span>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Site Name:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: SiteName"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Customer Name:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: CustomerName"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Machine ID:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: MachineID"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Install Path:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: InstallPath"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Machine Name:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: MachineName"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">User Count:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: TotalUserCount"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Is Permanent:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: IsPermanent"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Date Issued:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: DateIssued"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12" for="siteName">Expiration Date:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: ExpiryDate"></p>
            </div>
        </div>
        <div class="form-group compressed">
            <label class="control-label col-md-2 col-xs-12">Last Changed:</label>
            <div class="col-md-10 col-xs-9" data-bind="with: license">
                <p class="form-control-static" data-bind="text: ChangeTime"></p>
            </div>
        </div>
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10  col-xs-12">
                <div class="pull-right">
                    <a href="javascript:history.back()" class="btn btn-default">Cancel</a>
                    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-share-alt" aria-hidden="true"></span> Copy</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function LicenseViewModel() {
        var self = this;
        self.searchText = ko.observable('@ViewBag.SourceLicenseId');
        self.loading = ko.observable(false);
        self.license = ko.observable();

        $(document)
            .ajaxStart(function () { self.loading(true); })
            .ajaxStop(function () { self.loading(false); });

        self.delayedValue = ko.pureComputed(this.searchText)
            .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 400 } });

        self.delayedValue.subscribe(updateLicense, self);

        updateLicense(self.searchText());

        function updateLicense(val) {
            if (self.request) {
                self.request.abort();
            }
            self.license(undefined);
            self.request = $.post('/Licenses/Lookup', { id: val }, function (data) {
                self.license(data);
                self.request = undefined;
            });
        }
    }

    $(document).ready(function () {
        ko.applyBindings(new LicenseViewModel());
    });
</script>
}


@model ICSLicenseMaintV2.License
<div class="modal fade" id="newSiteModal" tabindex="-1" role="dialog" aria-labelledby="newSiteModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @using (Html.BeginForm(new { action = "AssignToNewSite" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel">New Site</h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="LicenseID" value="@Model.LicenseID" />
                    @Html.Partial("NewSite", (ICSLicenseMaintV2.ViewModels.NewSiteModel)ViewBag.NewSiteModel ?? new ICSLicenseMaintV2.ViewModels.NewSiteModel())
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <input type="submit" class="btn btn-primary" value="Save changes" />
                </div>
            }
        </div>
    </div>
</div>
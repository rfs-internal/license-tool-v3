@model ICSLicenseMaintV2.License


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" id="licenseHeader">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.LicenseID)
        @Html.HiddenFor(model => model.ProductID)
        @Html.HiddenFor(model => model.TimeOut)
        @Html.HiddenFor(model => model.DaysRemaining)

        <div class="form-group">
            <label class="control-label col-md-2" for="CustomerID">Customer</label>
            <div class="col-md-4">
                <select name="CustomerID" data-bind="options: customers, value: customer, optionsText: 'name', optionsValue: 'id'" class="form-control"></select>
            </div>
            <div class="col-md-6">
                <button class="btn btn-success" data-toggle="modal" data-target="#newCustomerSiteModal" type="button">
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> New Customer/Site
                </button>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="SiteID">Site</label>
            <div class="col-md-4">
                <select name="SiteID" data-bind="options: customersites, value: site, optionsText: 'name', optionsValue: 'id'" class="form-control"></select>
            </div>
            <div class="col-md-6">
                <button class="btn btn-success" data-toggle="modal" data-target="#newSiteModal" type="button">
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> New Site
                </button>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MachineID, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MachineID, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.MachineID, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.InstallPath, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.InstallPath, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.InstallPath, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MachineName, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MachineName, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.MachineName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TotalUserCount, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.TotalUserCount, new { htmlAttributes = new { @class = "form-control", Name = "UserCount" } })
                @Html.ValidationMessageFor(model => model.TotalUserCount, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.IsPermanent, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @if (IsAuthorized)
                {
                    <input type="checkbox" @(Model.IsPermanent ? "checked=\"\"" : "") />
                }
                else
                {
                    <input type="checkbox" @(Model.IsPermanent ? "checked=\"\"" : "") disabled />
                }
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DateIssued, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.DateIssued, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.DateIssued, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.LastRequestedUpdate, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.LastRequestedUpdate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.LastRequestedUpdate, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group @(Model.IsExpired ? "has-error" : "has-success")">
            @Html.LabelFor(model => model.ExpiryDate, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.ExpiryDate, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly", disabled = "disabled" } })
                @Html.ValidationMessageFor(model => model.ExpiryDate, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" for="AddDays">Add Days</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.DaysRemaining, new { htmlAttributes = new { @class = "form-control", Name = "AddDays", Value = "0" } })
                @Html.ValidationMessageFor(model => model.DaysRemaining, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save Header" class="btn btn-primary pull-right" />
            </div>
        </div>
    </div>
}


@model ICSLicenseMaintV2.License


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" id="licenseHeader">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.LicenseID)
        @Html.HiddenFor(model => model.ProductID)
        @Html.HiddenFor(model => model.TimeOut)
        @Html.HiddenFor(model => model.DaysRemaining)

        <div class="form-group">
            <label class="control-label col-md-2 col-xs-12" for="CustomerID" data-toggle="tooltip" data-placement="left" title="@LicenseMaintStrings.HelpCustomer">Customer</label>
            <div class="col-md-4 col-xs-9">
                <select name="CustomerID" data-bind="options: customers, value: customer, optionsText: 'name', optionsValue: 'id'" class="form-control"></select>
            </div>
            <div class="col-md-6 col-xs-3">
                <button class="btn btn-success" data-toggle="modal" data-target="#newCustomerSiteModal" type="button">
                    <span class="glyphicon glyphicon-plus" aria-hidden="true"></span> <span class="hidden-xs">New Customer</span><span class="visible-xs-inline-block">New</span>
                </button>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.TotalUserCount, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpUserCount })
            <div class="col-md-4 col-xs-9">
                @Html.EditorFor(model => model.TotalUserCount, new { htmlAttributes = new { @class = "form-control", Name = "UserCount" } })
                @Html.ValidationMessageFor(model => model.TotalUserCount, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.LicenseID, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle="tooltip", data_placement="left", title = LicenseMaintStrings.HelpLicenseID })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.LicenseID)
                <p class="form-control-static">@Html.Raw(Model.LicenseID)</p>
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.MachineName, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpMachineName })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.MachineName)
                <p class="form-control-static">@Html.Raw(Model.MachineName)</p>
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.MachineID, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpMachineID })
            <div class="col-md-4">
                @Html.HiddenFor(model => model.MachineID)
                <p class="form-control-static">@Html.Raw(Model.MachineID)</p>
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.InstallPath, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpInstallPath })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.InstallPath)
                <p class="form-control-static">@Html.Raw(Model.InstallPath)</p>
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.IsPermanent, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpPermanent })
            <div class="col-md-10">
                @if (IsAuthorized)
                {
                    @Html.EditorFor(m=>m.IsPermanent)
                }
                else
                {
                    <input type="checkbox" @(Model.IsPermanent ? "checked=\"\"" : "") disabled  name="IsPermanent"/>
                }
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.ChangeTime, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpLastChanged })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.ChangeUserID)
                @Html.HiddenFor(model => model.ChangeTime)
                @Html.HiddenFor(model => model.LastRequestedUpdate)
                <p class="form-control-static">@Html.Raw(Model.ChangeTime) (@Html.Raw(Model.ChangeUserID))</p>
            </div>
        </div>

        <div class="form-group compressed">
            @Html.LabelFor(model => model.DateIssued, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpDateIssued })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.DateIssued)
                <p class="form-control-static">@Html.Raw(Model.DateIssued)</p>
            </div>
        </div>

        <div class="form-group compressed @(Model.IsExpired ? "has-error" : "has-success")">
            @Html.LabelFor(model => model.ExpiryDate, htmlAttributes: new { @class = "control-label col-md-2 col-xs-12", data_toggle = "tooltip", data_placement = "left", title = LicenseMaintStrings.HelpExpiryDate })
            <div class="col-md-10">
                @Html.HiddenFor(model => model.ExpiryDate)
                <p class="form-control-static">@Html.Raw(Model.ExpiryDate)</p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2 col-xs-12" for="AddDays" data-toggle="tooltip" data-placement="left" title="@LicenseMaintStrings.HelpAddDays">Add Days</label>
            <div class="col-md-4 col-xs-9">
                @Html.EditorFor(model => model.DaysRemaining, new { htmlAttributes = new { @class = "form-control", Name = "AddDays", Value = "0" } })
                @Html.ValidationMessageFor(model => model.DaysRemaining, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10  col-xs-12">
                <div class="pull-right">
                    <a href="@Url.Action("Delete", new { id = Model.LicenseID })" class="btn btn-danger"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span> <span class="hidden-xs">Delete</span></a>
                    <a href="@Url.Action("DownloadLicenseFile", new { id = Model.LicenseID })" class="btn btn-primary"><span class="glyphicon glyphicon-download-alt" aria-hidden="true"></span> <span class="hidden-xs">Download License File</span></a>
                    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-saved" aria-hidden="true"></span> Save Header</button>
                </div>
            </div>
        </div>
    </div>
}


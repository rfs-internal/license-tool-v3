@model IEnumerable<ICSLicenseMaintV2.License>

@{
    ViewBag.Title = "Global Search";
    ViewBag.LicenseData = true;
}

@section Scripts {
    <script>
        function SearchViewModel() {
            var self = this;
            self.searchText = ko.observable();
            self.licenses = ko.observableArray();
            self.canLoadMore = ko.observable(false);
            self.loading = ko.observable(false);
            self.page = 0;
            self.hasResults = ko.computed(function () {
                return self.licenses().length > 0;
            });

            self.setLastSearch = function (lastSearch) {
                if (Modernizr.localstorage) { localStorage.setItem('lastSeach', lastSearch); }
            };
            self.getLastSearch = function () {
                if (Modernizr.localstorage) {
                    var lastSearch = localStorage.getItem('lastSeach');
                    return lastSearch == "null" ? '' : lastSearch;
                }
                else { return ''; }
            };

            self.searchText(self.getLastSearch());

            $(document)
                .ajaxStart(function () { self.loading(true); })
                .ajaxStop(function () { self.loading(false); });

            //self.licenses.subscribe(function () {
            //    $('#searchResultsTable').DataTable({
            //        destroy: true,
            //        bPaginate: false
            //    });
            //});

            self.delayedValue = ko.pureComputed(this.searchText)
                .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 400 } });

            self.showDemos = ko.computed(function () { return !self.delayedValue(); });

            self.delayedValue.subscribe(updateValue, self);

            updateValue(self.searchText());

            function updateValue(val) {
                self.setLastSearch(val);
                if (val !== '') {
                    if (self.request) {
                        self.request.abort();
                    }
                    self.page = 0;
                    self.request = $.post('/LicenseSearch/SearchAjax', { searchText: val, page: self.page }, function (data) {
                        self.licenses(data.results);
                        self.canLoadMore(data.canLoadMore)
                        self.request = undefined;

                        // Enable bootstrap tooltips:
                        $('[data-toggle="tooltip"]').tooltip({ container: 'body' });
                    });
                } else {
                    self.licenses([]);
                    self.canLoadMore(false);
                }
            }
            
            self.loadMore = function () {
                if (self.request) {
                    self.request.abort();
                }
                self.page++;
                self.request = $.post('/LicenseSearch/SearchAjax', { searchText: self.searchText(), page: self.page }, function (data) {
                    var temp = self.licenses();
                    self.licenses(temp.concat(data.results));
                    self.canLoadMore(data.canLoadMore);
                    self.request = undefined;
                });
            };
        }

        $(document).ready(function () {
            ko.applyBindings(new SearchViewModel());
        });

        ko.bindingHandlers.sort = {
            all: [],
            init: function (element, valueAccessor, allBindingsAccessor, viewModel, bindingContext) {
                var asc = false;
                element.style.cursor = 'pointer';
                var all = ko.bindingHandlers.sort.all;
                all.push(element);
                element.onclick = function () {
                    var value = valueAccessor();
                    var prop = value.prop;
                    var data = value.arr;

                    asc = !asc;
                    all.forEach(function (x) { x.classList.remove('sorting', 'sorting_asc', 'sorting_desc'); x.classList.add('sorting'); });
                    this.classList.remove('sorting');
                    this.classList.add(asc ? 'sorting_asc' : 'sorting_desc');
                    data.sort(function (left, right) {
                        var rec1 = left;
                        var rec2 = right;

                        if (!asc) {
                            rec1 = right;
                            rec2 = left;
                        }

                        var props = prop.split('.');
                        for (var i in props) {
                            var propName = props[i];
                            var parenIndex = propName.indexOf('()');
                            if (parenIndex > 0) {
                                propName = propName.substring(0, parenIndex);
                                rec1 = rec1[propName]();
                                rec2 = rec2[propName]();
                            } else {
                                rec1 = rec1[propName];
                                rec2 = rec2[propName];
                            }
                        }

                        return rec1 == rec2 ? 0 : rec1 < rec2 ? -1 : 1;
                    });
                };
            }
        };
    </script>
}

<h2>Global Search</h2>

<div class="row">
    <div class="col-md-11">
        <input type="text" class="form-control input-lg" placeholder="Search for machine name, customer, license id, etc." style="max-width:unset;" autofocus data-bind="value: searchText, valueUpdate: ['input', 'afterkeydown']">
    </div>
    <div class="col-md-1">
        <!-- ko if: loading -->
            <img src="~/Content/loading.gif" width="45" height="45"/>
        <!-- /ko -->
    </div>
</div>

<!-- ko if: hasResults -->
<hr />
<h3>Results</h3>
<table class="table table-condensed table-hover dataTable" id="searchResultsTable">
    <thead>
        <tr>
            <th></th>
            <th class="hidden-xs sorting" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpLicenseID" data-bind="sort: { arr: licenses, prop: 'LicenseID' }">ID</th>
            <th class="hidden-xs sorting" data-bind="sort: { arr: licenses, prop: 'CustomerName' }">Customer</th>
            <th class="hidden-xs" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpMachineID">Machine ID</th>
            <th class="sorting" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpMachineName" data-bind="sort: { arr: licenses, prop: 'MachineName' }">Machine Name</th>
            <th class="hidden-xs sorting" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpUserCount" data-bind="sort: { arr: licenses, prop: 'TotalUserCount' }">Users</th>
            <th class="hidden-xs" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpPermanent" >Permanent</th>
            <th class="hidden-xs" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpExpiryDate">Expires</th>
            <th class="hidden-xs" data-toggle="tooltip" data-placement="top" title="@LicenseMaintStrings.HelpLastChanged">Last Changed</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: licenses">
        <tr data-bind="css: { danger: IsExpired }">
            <td>
                <a data-bind="attr: { href: '/Licenses/Edit/'+LicenseID }">Edit</a> |
                <a data-bind="attr: { href: '/Licenses/Delete/'+LicenseID }">Delete</a>
            </td>
            <td data-bind="text: LicenseID" class="hidden-xs"></td>
            @*<td data-bind="attr: { title: MachineID }, text: ShortMachineID"></td>*@
            <td class="hidden-xs">
                <a data-bind="attr: { href: '/Licenses/Index/' + CustomerID}, text: CustomerName"></a>
            </td>
            <td data-bind="text: MachineID" class="hidden-xs"></td>
            <td data-bind="text: MachineName"></td>
            <td data-bind="text: TotalUserCount" class="hidden-xs"></td>
            <td class="hidden-xs">
                <input type="checkbox" disabled readonly data-bind="checked: IsPermanent"/>
            </td>
            <td class="hidden-xs">
                <span data-bind="if: IsPermanent">-</span>
                <!-- ko if: !IsPermanent-->
                <span data-bind="text: ExpiryDate"></span>
                <!-- /ko -->
            </td>
            <td data-bind="text: ChangeTime" class="hidden-xs"></td>
        </tr>
    </tbody>
</table>
<!-- /ko -->
<!-- ko if: canLoadMore -->
<button class="btn btn-primary" data-bind="click: loadMore" type="Button">Load More</button>
<!-- /ko -->

<!-- ko if: showDemos -->
<hr />
<h3>Last 10 Demo License Requests</h3>
@Html.Partial("_LicenseList")
<!-- /ko -->
@model IEnumerable<ICSLicenseMaintV2.License>

@{
    ViewBag.Title = "Global Search";
    ViewBag.LicenseData = true;
}

@section Scripts {
    <script>
        function SearchViewModel() {
            var self = this;
            self.searchText = ko.observable();
            self.licenses = ko.observableArray();
            self.canLoadMore = ko.observable(false);
            self.loading = ko.observable(false);
            self.page = 0;
            self.hasResults = ko.computed(function () {
                return self.licenses().length > 0;
            });

            $(document)
                .ajaxStart(function () { self.loading(true); })
                .ajaxStop(function () { self.loading(false); });

            //self.licenses.subscribe(function () {
            //    $('#searchResultsTable').DataTable({
            //        destroy: true,
            //        bPaginate: false
            //    });
            //});

            self.delayedValue = ko.pureComputed(this.searchText)
                .extend({ rateLimit: { method: "notifyWhenChangesStop", timeout: 400 } });

            self.showDemos = ko.computed(function () { return !self.delayedValue(); });

            self.delayedValue.subscribe(function (val) {
                if (val !== '') {
                    if (self.request) {
                        self.request.abort();
                    }
                    self.page = 0;
                    self.request = $.post('/LicenseSearch/SearchAjax', { searchText: val, page: self.page }, function (data) {
                        self.licenses(data.results);
                        self.canLoadMore(data.canLoadMore)
                        self.request = undefined;
                    });
                } else {
                    self.licenses([]);
                    self.canLoadMore(false);
                }
            }, self);
            
            self.loadMore = function () {
                if (self.request) {
                    self.request.abort();
                }
                self.page++;
                self.request = $.post('/LicenseSearch/SearchAjax', { searchText: self.searchText(), page: self.page }, function (data) {
                    var temp = self.licenses();
                    self.licenses(temp.concat(data.results));
                    self.canLoadMore(data.canLoadMore);
                    self.request = undefined;
                });
            };
        }

        $(document).ready(function () {
            ko.applyBindings(new SearchViewModel());
        });
    </script>
}

<h2>Global Search</h2>

<div class="row">
    <div class="col-md-11">
        <input type="text" class="form-control input-lg" placeholder="Search for machine name, customer, license id, etc." style="max-width:unset;" autofocus data-bind="value: searchText, valueUpdate: ['input', 'afterkeydown']">
    </div>
    <div class="col-md-1">
        <!-- ko if: loading -->
            <img src="~/Content/loading.gif" width="45" height="45"/>
        <!-- /ko -->
    </div>
</div>

<!-- ko if: hasResults -->
<hr />
<h3>Results</h3>
<table class="table table-condensed table-hover" id="searchResultsTable">
    <thead>
        <tr>
            <th></th>
            <th>ID</th>
            <th>Customer</th>
            <th>Machine ID</th>
            <th>Machine Name</th>
            <th>Users</th>
            <th>Permanent</th>
            <th>Expires</th>
            <th>Last Request</th>
        </tr>
    </thead>
    <tbody data-bind="foreach: licenses">
        <tr data-bind="css: { danger: IsExpired }">
            <td>
                <a data-bind="attr: { href: '/Licenses/Edit/'+LicenseID }">Edit</a> |
                <a data-bind="attr: { href: '/Licenses/Delete/'+LicenseID }">Delete</a>
            </td>
            <td data-bind="text: LicenseID"></td>
            @*<td data-bind="attr: { title: MachineID }, text: ShortMachineID"></td>*@
            <td>
                <a data-bind="attr: { href: '/Licenses/Index/' + CustomerID}, text: CustomerName"></a>
            </td>
            <td data-bind="text: MachineID"></td>
            <td data-bind="text: MachineName"></td>
            <td data-bind="text: TotalUserCount"></td>
            <td>
                <input type="checkbox" disabled readonly data-bind="checked: IsPermanent"/>
            </td>
            <td>
                <span data-bind="if: IsPermanent">-</span>
                <!-- ko if: !IsPermanent-->
                <span data-bind="text: ExpiryDate"></span>
                <!-- /ko -->
            </td>
            <td data-bind="text: LastRequestedUpdate"></td>
        </tr>
    </tbody>
</table>
<!-- /ko -->
<!-- ko if: canLoadMore -->
<button class="btn btn-primary" data-bind="click: loadMore" type="Button">Load More</button>
<!-- /ko -->

<!-- ko if: showDemos -->
<hr />
<h3>Last 10 Demo License Requests</h3>
@Html.Partial("_LicenseList")
<!-- /ko -->

@{
    ViewBag.Title = "Upload License File";
}

<h2>Proxy License Request</h2>

@using(Html.BeginForm("Upload", "ProxyRequest", FormMethod.Post, new { enctype = "multipart/form-data", @class="form-horizontal" }))
{
    <div class="form-group">
        <label for="licenserequest" class="col-sm-2 control-label">Load File</label>
        <div class="col-sm-10">
            <input type="file" class="form-control" name="licenserequest">
        </div>
    </div>
    <div class="form-group">
        <label for="licenseurl"  class="col-sm-2 control-label">URL</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" name="licenseurl" value="http://icslicense.icsfl.com:83/Weblicense/ICSLicensing.asmx">
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-send" aria-hidden="true"></span> Create License</button>
}

@{
    ViewBag.Title = "Proxy License Request";
}

<h2>Proxy License Request</h2>

@using(Html.BeginForm("Upload", "ProxyRequest", FormMethod.Post, new { enctype = "multipart/form-data", @class="form-horizontal" }))
{
    <div class="form-group">
        <label for="licenserequest" class="col-sm-2 control-label">Load File</label>
        <div class="col-sm-10">
            <input type="file" class="form-control" name="licenserequest">
        </div>
    </div>
    <div class="form-group">
        <label for="licenseurl"  class="col-sm-2 control-label">URL</label>
        <div class="col-sm-10">
            <input type="text" class="form-control" name="licenseurl" value="http://icslicense.icsfl.com/Weblicense/ICSLicensing.asmx">
        </div>
    </div>
    <input type="submit" class="btn btn-primary" name="action" value="Request Update"/>
    <input type="submit" class="btn btn-primary" name="action" value="Request Demo" />
}